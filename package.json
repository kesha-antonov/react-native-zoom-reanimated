{
  "name": "react-native-zoom-reanimated",
  "version": "1.5.6",
  "type": "module",
  "description": "Smooth pinch-to-zoom component for React Native with Apple Photos-style gestures and rubber-band physics",
  "workspaces": [
    "example"
  ],
  "keywords": [
    "react-native",
    "expo",
    "zoom",
    "zoomable",
    "pinch",
    "pinch-to-zoom",
    "double-tap",
    "pan",
    "gesture",
    "image",
    "image-viewer",
    "photo-viewer",
    "lightbox",
    "gallery",
    "reanimated",
    "gesture-handler",
    "new-architecture",
    "typescript",
    "ios",
    "android"
  ],
  "homepage": "https://github.com/kesha-antonov/react-native-zoom-reanimated",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kesha-antonov/react-native-zoom-reanimated.git"
  },
  "bugs": {
    "url": "https://github.com/kesha-antonov/react-native-zoom-reanimated/issues"
  },
  "license": "MIT",
  "author": "Kesha Antonov <innokenty.longway@gmail.com>",
  "packageManager": "yarn@4.18.0",
  "source": "./src/index.tsx",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "react-native": "./src/index.tsx",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "README.md",
    "LICENSE",
    "package.json",
    "src/",
    "lib/",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "autofix": "eslint --fix .",
    "bump": "npm version patch",
    "clean": "del-cli lib",
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "yarn workspace example run test",
    "release": "npm publish",
    "prepublishOnly": "yarn test && npm run lint",
    "prepare": "husky && bob build"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@react-native/metro-config": "^0.86.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/react": "^19.2.18",
    "del-cli": "^7.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-builder-bob": "^0.43.0",
    "react-native-gesture-handler": "^3.1.0",
    "react-native-reanimated": "^4.5.3",
    "react-native-worklets": "^0.11.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": ">=3.0.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  }
}
